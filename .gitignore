# ==============================================================================
# Next.js Official Patterns
# ==============================================================================
# Next.js build and production output
.next/
out/

# Dependency directories
node_modules/
dist/

# Next.js telemetry and build logs
next-env.d.ts
.pnp
.pnp.js

# Testing and coverage outputs
coverage/
.nyc_output/

# Vercel deployments and project configurations
.vercel

# ==============================================================================
# Environment Variables & Secrets (CRITICAL)
# ==============================================================================
# Block all local environment secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# DO NOT block the template file if you use one
# !.env.example

# ==============================================================================
# Build & Diagnostic Logs
# ==============================================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Debug logs used by tools like Winston or Bunyan
logs
*.log

# ==============================================================================
# OS Generated Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ==============================================================================
# IDEs and Text Editors
# ==============================================================================
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/

# Local history / backups
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
